{
  "private": true,
  "devDependencies": {
    "@wordpress/env": "^10.0.0",
    "effect": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "scripts": {
    "cs": "composer cs",
    "cs:fix": "composer cs:fix",
    "test": "node tests/run-all.ts",
    "test:unit": "composer test:unit",
    "test:integration": "composer test:integration",
    "test:security": "composer test:security",
    "test:phpunit": "composer test",
    "test:e2e": "node tests/e2e/run-all.ts",
    "test:e2e:wp-env": "node tests/e2e/test-wp-env.ts",
    "typecheck": "tsc --noEmit",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "check:docs": "node scripts/check-docs-content.ts --root docs --expected-docs 18 --expected-nav 3",
    "test:all": "node tests/run-all.ts"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0",
    "pnpm": ">=12.14.0"
